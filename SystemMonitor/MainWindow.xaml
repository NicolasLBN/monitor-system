<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemMonitor"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="System Monitor" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="System Monitor" FontSize="24" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CPU Monitor (Needle Gauge) -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="#3F3F3F" BorderThickness="1" 
                    Background="#2D2D2D" CornerRadius="5" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="CPU Usage" FontSize="18" FontWeight="Bold" 
                               Foreground="#4EC9B0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <lvc:Gauge Grid.Row="1" x:Name="CpuGauge" Uses360Mode="False" 
                               From="0" To="100" Value="0" 
                               LabelsVisibility="Collapsed"
                               GaugeActiveFill="#4EC9B0"
                               GaugeBackground="#3F3F3F"
                               Foreground="White"
                               FontSize="40" FontWeight="Bold"
                               Margin="10"/>
                    
                    <TextBlock Grid.Row="2" x:Name="CpuPercentText" Text="0%" 
                               FontSize="24" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- RAM Monitor (Line Chart) -->
            <Border Grid.Column="1" Grid.Row="0" BorderBrush="#3F3F3F" BorderThickness="1" 
                    Background="#2D2D2D" CornerRadius="5" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="RAM Usage" FontSize="18" FontWeight="Bold" 
                               Foreground="#CE9178" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <lvc:CartesianChart Grid.Row="1" x:Name="RamChart" Series="{Binding RamSeries}"
                                        Background="Transparent" Foreground="White">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding RamLabels}" FontSize="10" Foreground="#808080"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="%" FontSize="12" Foreground="#808080" MinValue="0" MaxValue="100"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="RamUsedText" Text="Used: 0 GB" 
                                   FontSize="14" Foreground="White" Margin="0,0,15,0"/>
                        <TextBlock x:Name="RamTotalText" Text="Total: 0 GB" 
                                   FontSize="14" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- GPU Monitor (Line Chart) -->
            <Border Grid.Column="2" Grid.Row="0" BorderBrush="#3F3F3F" BorderThickness="1" 
                    Background="#2D2D2D" CornerRadius="5" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="GPU Usage" FontSize="18" FontWeight="Bold" 
                               Foreground="#6AAED5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <lvc:CartesianChart Grid.Row="1" x:Name="GpuChart" Series="{Binding GpuSeries}"
                                        Background="Transparent" Foreground="White">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding GpuLabels}" FontSize="10" Foreground="#808080"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="%" FontSize="12" Foreground="#808080" MinValue="0" MaxValue="100"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                    
                    <TextBlock Grid.Row="2" Text="GPU Utilization" 
                               FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Disk Monitor (Column Chart) -->
            <Border Grid.Column="0" Grid.Row="1" BorderBrush="#3F3F3F" BorderThickness="1" 
                    Background="#2D2D2D" CornerRadius="5" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Disk Usage" FontSize="18" FontWeight="Bold" 
                               Foreground="#C586C0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <lvc:CartesianChart Grid.Row="1" x:Name="DiskChart" Series="{Binding DiskSeries}"
                                        Background="Transparent" Foreground="White">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding DiskLabels}" FontSize="10" Foreground="#808080"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="GB" FontSize="12" Foreground="#808080"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                    
                    <TextBlock Grid.Row="2" x:Name="DiskInfoText" Text="Disks: 0" 
                               FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Network & System Info -->
            <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#3F3F3F" BorderThickness="1" 
                    Background="#2D2D2D" CornerRadius="5" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Network &amp; System Info" FontSize="18" FontWeight="Bold" 
                               Foreground="#DCDCAA" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Network Section -->
                            <TextBlock Text="Network" FontSize="14" FontWeight="Bold" 
                                       Foreground="#569CD6" Margin="0,5"/>
                            <StackPanel x:Name="NetworkPanel" Margin="10,0,0,10">
                                <TextBlock x:Name="NetworkDownloadText" Text="Download: 0 KB/s" 
                                           FontSize="12" Foreground="White" Margin="0,2"/>
                                <TextBlock x:Name="NetworkUploadText" Text="Upload: 0 KB/s" 
                                           FontSize="12" Foreground="White" Margin="0,2"/>
                            </StackPanel>
                            
                            <!-- System Info Section -->
                            <TextBlock Text="System Information" FontSize="14" FontWeight="Bold" 
                                       Foreground="#569CD6" Margin="0,10,0,5"/>
                            <StackPanel x:Name="SystemInfoPanel" Margin="10,0,0,10">
                                <TextBlock x:Name="OsText" Text="OS: Loading..." 
                                           FontSize="12" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ComputerNameText" Text="Computer: Loading..." 
                                           FontSize="12" Foreground="White" Margin="0,2"/>
                                <TextBlock x:Name="ProcessorText" Text="Processor: Loading..." 
                                           FontSize="12" Foreground="White" Margin="0,2" TextWrapping="Wrap"/>
                                <TextBlock x:Name="UptimeText" Text="Uptime: Loading..." 
                                           FontSize="12" Foreground="White" Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Recording Controls -->
        <Border Grid.Row="2" BorderBrush="#3F3F3F" BorderThickness="1" 
                Background="#2D2D2D" CornerRadius="5" Margin="10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Performance Recording:" 
                           FontSize="16" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <TextBlock Grid.Column="1" x:Name="RecordingStatusText" 
                           Text="Ready to record" FontSize="14" 
                           Foreground="#808080" VerticalAlignment="Center"/>
                
                <Button Grid.Column="2" x:Name="StartRecordButton" Content="Start Recording" 
                        Width="140" Height="35" Margin="0,0,10,0"
                        Background="#4EC9B0" Foreground="Black" FontWeight="Bold"
                        BorderThickness="0" Click="StartRecordButton_Click"/>
                
                <Button Grid.Column="3" x:Name="StopRecordButton" Content="Stop Recording" 
                        Width="140" Height="35" IsEnabled="False"
                        Background="#F48771" Foreground="Black" FontWeight="Bold"
                        BorderThickness="0" Click="StopRecordButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
